# Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=

# Image Optimization
NEXT_PUBLIC_IMAGE_OPTIMIZATION=true

# لوحة إدارة الموقع /admin — كلمة السر (6 أحرف فأكثر). بدونها تبقى اللوحة معطّلة.
ADMIN_PASSWORD=

# مفتاح نموذج التواصل (Web3Forms) لإرسال الرسائل إلى بريدك
NEXT_PUBLIC_WEB3FORMS_KEY=

# رمز GitHub لزر "حفظ ونشر" في لوحة الإدارة (Contents: Read and write)
GITHUB_TOKEN=
GITHUB_REPO=maximumadvye-source/maximum
GITHUB_BRANCH=main
